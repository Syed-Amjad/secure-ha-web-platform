# {{ ansible_managed }}
# Root-owned, group-readable by {{ app_name }} only (mode 0640).
#
# Credentials live here rather than in the systemd unit, because `systemctl cat`
# is readable by every user on the box.
DB_HOST={{ db_primary_private_ip }}
DB_NAME={{ app_db_name }}
DB_USER={{ app_db_user }}
DB_PASS={{ app_db_password }}
APP_PORT={{ app_port }}
