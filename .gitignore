# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log

# .terraform.lock.hcl is deliberately NOT ignored. It pins provider versions and
# their checksums, so anyone cloning this gets the same providers you tested
# against. HashiCorp's guidance is to commit it.

# tfvars hold a Cloudflare API token and your home IP address.
# environments/prod.tfvars is committed ONLY as a template with placeholders.
*.auto.tfvars
terraform.tfvars
!environments/prod.tfvars

# ---------------------------------------------------------------------------
# Ansible
# ---------------------------------------------------------------------------
# Generated by scripts/gen-inventory.sh, and it contains addresses.
ansible/inventory.ini
*.retry
vault-password.txt
group_vars/all/vault.yml

# ---------------------------------------------------------------------------
# Keys and secrets — never, under any circumstances
# ---------------------------------------------------------------------------
*.pem
*.key
*.p12
.env
.env.*

# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
*.log
# ...except the drill and test captures. docs/DR-test-results.md cites these as
# its raw evidence, and a results file whose evidence is gitignored is an
# assertion again.
!docs/evidence/*.log
/tmp/
.DS_Store
Thumbs.db

